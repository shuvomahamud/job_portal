# Neon Postgres
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Scoped integration secrets (use independent, randomly generated values)
HERMES_COMMAND_SECRET=replace_with_a_long_random_secret
WORKER_API_SECRET=replace_with_a_different_long_random_secret
N8N_WEBHOOK_SECRET=replace_with_a_different_long_random_secret
EXTENSION_API_SECRET=replace_with_a_different_long_random_secret

# Public deployment origin, without a trailing slash
APP_BASE_URL=http://localhost:3000

# Seed-only identity. Match a real Clerk user id after creating your account.
SEED_USER_EMAIL=alex@example.com
SEED_USER_NAME=Alex Morgan
SEED_USER_AUTH_PROVIDER_ID=seed_user
