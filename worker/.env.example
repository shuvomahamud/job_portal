# Worker configuration. Use one env file per machine; do not commit real values.
DATABASE_URL="postgresql://user:***@host/neondb?sslmode=require"
DASHBOARD_BASE_URL="https://your-dashboard.vercel.app"
WORKER_API_SECRET="replace_with_a_different_long_random_secret"
WORKER_ID="job-discovery-vps-01"

# Lightweight defaults
WORKER_POLL_INTERVAL_SECONDS=10
WORKER_CLAIM_LIMIT=1
WORKER_MAX_CONCURRENCY=1
WORKER_COMMAND_TYPES="find_matching_jobs,discover_jobs_browser,import_jobs,run_rule_filter"
WORKER_IDLE_BACKOFF_MAX_SECONDS=60
JOB_SEARCH_MAX_RESULTS_PER_COMMAND=50
JOB_SOURCE_DELAY_MS=3000
JOB_IMPORT_FETCH_TIMEOUT_MS=12000
JOB_IMPORT_FETCH_DESCRIPTIONS=false

# VPS browser-assisted discovery. Enable only on the VPS browser profile where you are logged in.
JOB_BROWSER_DISCOVERY_ENABLED=false
JOB_BROWSER_USER_DATA_DIR="/home/shuvo/.job-worker-browser-profile"
JOB_BROWSER_HEADLESS=false
JOB_BROWSER_MIN_DELAY_MS=15000
JOB_BROWSER_MAX_DELAY_MS=45000
JOB_BROWSER_SLOW_MO_MS=500
JOB_BROWSER_NAVIGATION_TIMEOUT_MS=60000
JOB_BROWSER_MAX_RESULTS_PER_COMMAND=25
JOB_BROWSER_MAX_PAGES_PER_SEARCH=1
# Enable only for a dedicated loopback CDP browser. Each run replaces stale tabs
# with one fresh blank tab before Playwright connects.
JOB_BROWSER_CDP_URL="http://127.0.0.1:9222"
JOB_BROWSER_CDP_MANAGE_PAGES=false
JOB_BROWSER_CDP_CONNECT_TIMEOUT_MS=30000
JOB_BROWSER_CDP_CLEANUP_TIMEOUT_MS=10000

# Mac AI worker only. Use a separate env file and command allow-list there.
# WORKER_ID="job-ai-mac-01"
# WORKER_COMMAND_TYPES="run_local_llm_extraction"
AI_MATCH_PROVIDER=ollama
OLLAMA_BASE_URL="http://127.0.0.1:11434"
# For a centralized VPS worker calling Ollama over Tailscale, list only the
# exact Mac Tailscale IP or MagicDNS host here.
OLLAMA_ALLOWED_REMOTE_HOSTS=""
OLLAMA_MODEL="qwen3.5:9b"
OLLAMA_REQUEST_TIMEOUT_MS=90000
OLLAMA_KEEP_ALIVE="30m"
AI_MATCH_MAX_CONCURRENCY=1
AI_MATCH_MAX_JOB_DESCRIPTION_CHARS=50000
AI_MATCH_RETRY_LIMIT=1

# Optional: remote review is only used for uncertain local results.
REMOTE_AI_REVIEW_ENABLED=false
OPENAI_API_KEY=""
OPENAI_REVIEW_MODEL="gpt-5.6-terra"
OPENAI_REVIEW_REASONING_EFFORT="medium"
OPENAI_REVIEW_TIMEOUT_MS=90000
REMOTE_AI_REVIEW_MAX_PER_RUN=5

# Mac application worker. Limits reset at the beginning of every apply run; there is
# intentionally no calendar-day quota.
JOB_APPLY_NOTIFY_CHANNEL="desktop"
JOB_APPLY_QUESTION_TTL_HOURS=72
JOB_APPLY_ENABLED=false
JOB_APPLY_MODE="dry_run"
JOB_APPLY_MAX_PER_RUN=15
JOB_APPLY_MAX_MINUTES_PER_APPLICATION=20
JOB_APPLY_MAX_STEPS=8
JOB_APPLY_MIN_GAP_SECONDS=90
JOB_APPLY_MAX_GAP_SECONDS=420
JOB_APPLY_TRACE=true
JOB_APPLY_TRUST_LLM_ANSWERS=false
# WORKER_OWNER_USER_ID="00000000-0000-4000-8000-000000000000"
