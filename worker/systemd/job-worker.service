[Unit]
Description=Job Portal VPS Discovery Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/shuvo/project/job_portal
Environment=NODE_ENV=production
Environment=WORKER_ENV_FILE=/home/shuvo/.job-portal/vps-worker.env
ExecStart=/usr/bin/npm run worker:start
Restart=always
RestartSec=10
User=shuvo
Group=shuvo
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/shuvo/project/job_portal /home/shuvo/.job-portal /home/shuvo/.job-worker-browser-profile

[Install]
WantedBy=multi-user.target
